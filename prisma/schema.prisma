datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["book_dealer", "public"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

model StoreMeta {
  singleton   Boolean @id @default(true)
  revision    BigInt  @default(0)
  initialized Boolean @default(false)

  @@map("store_meta")
  @@schema("book_dealer")
}

model BusinessProfileRecord {
  singleton Boolean @id @default(true)
  payload   Json

  @@map("business_profile")
  @@schema("book_dealer")
}

model PublisherRecord {
  position BigInt  @id
  payload  Json
  appId    String? @map("app_id")

  @@index([appId], map: "publishers_app_id_idx")
  @@map("publishers")
  @@schema("book_dealer")
}

model BookRecord {
  position BigInt  @id
  payload  Json
  appId    String? @map("app_id")

  @@index([appId], map: "books_app_id_idx")
