# Copy these names into backend/.env. Never put a backend secret in a VITE_ variable.
DATA_STORE=supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_SERVICE_ROLE_KEY is also accepted instead of SUPABASE_SECRET_KEY.

# Needed only to apply SQL automatically. Get this from Supabase Connect.
DATABASE_URL=
# Official Supabase CA is included; set this only to override its location.
DATABASE_SSL_CA_FILE=

PORT=3000
